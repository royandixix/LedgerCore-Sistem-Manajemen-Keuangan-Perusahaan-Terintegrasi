{
    "name": "ledgercore",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.9.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "dev:web": "pnpm --filter web dev",
        "dev:api": "pnpm --filter api start:dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "db:validate": "pnpm --filter api exec prisma validate",
        "db:generate": "pnpm --filter api exec prisma generate"
    },
    "devDependencies": {
        "turbo": "^2.6.0"
    }
}